{
  "folders": [
    {
      "name": "Querya (Flutter + monorepo)",
      "path": "."
    },
    {
      "name": "apps/tauri",
      "path": "apps/tauri"
    }
  ],
  "settings": {
    "rust-analyzer.linkedProjects": [
      "apps/tauri/src-tauri/Cargo.toml"
    ],
    "rust-analyzer.cargo.targetDir": true,
    "files.watcherExclude": {
      "**/apps/tauri/src-tauri/target/**": true,
      "**/apps/tauri/node_modules/**": true,
      "**/apps/tauri/dist/**": true,
      "**/.dart_tool/**": true,
      "**/build/**": true
    }
  },
  "extensions": {
    "recommendations": [
      "Dart-Code.dart-code",
      "Dart-Code.flutter",
      "Vue.volar",
      "tauri-apps.tauri-vscode",
      "rust-lang.rust-analyzer"
    ]
  }
}
